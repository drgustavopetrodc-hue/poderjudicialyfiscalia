                                                 
                                                              

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

                              
enum Rol {
  ADMIN
  JUEZ
  FISCAL
  ABOGADO
  FUNCIONARIO
  CIUDADANO                                                          
}

enum EstadoCertificacion {
  PENDIENTE
  APROBADA
  RECHAZADA
  SUSPENDIDA
}

enum EstadoCausa {
  EN_INVESTIGACION
  FORMALIZADA
  EN_JUICIO
  EN_ESPERA_JUICIO
  EN_APELACION
  SENTENCIADA
  CERRADA
  ARCHIVADA
  SOBRESEIDA
}

enum EstadoOrdenCaptura {
  VIGENTE
  EJECUTADA
  LEVANTADA
}

enum EstadoDenuncia {
  PENDIENTE
  RECIBIDA
  REVISADA
}

enum CategoriaSolicitud {
  FISCALIA
  PODER_JUDICIAL
  DEFENSORIA_PENAL
}

enum EstadoSolicitud {
  ABIERTA
  EN_REVISION
  RESUELTA
  CERRADA
}

enum EstadoDemanda {
  INGRESADA
  EN_REVISION
  ADMITIDA
  OBSERVADA
  RECHAZADA
}

enum TipoAdjuntoDenuncia {
  IMAGEN
  VIDEO
}

enum TipoAdjuntoFiscal {
  EVIDENCIA_VISUAL
  OFICIO
  VIDEO
}

enum TipoAudiencia {
  FORMALIZACION
  PREPARACION_JUICIO
  JUICIO_ORAL
  LECTURA_SENTENCIA
  OTRA
}

enum EstadoAudiencia {
  PROGRAMADA
  REALIZADA
  SUSPENDIDA
  CANCELADA
}

                                        
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

                                
model User {
  id            String    @id @default(cuid())
  name          String?
  discordId     String?   @unique                                                                    
  discordTag    String?                                     
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?                                                     
  rol           Rol       @default(CIUDADANO)
  activo        Boolean   @default(true)
  creadoEn      DateTime  @default(now())

                                                        
                                                                             
                                                                       
  nombreIC      String?
  rut           String?   @unique
  nif           String?   @unique                                                                            
  nacionalidad  String?
  institucion   String?                                                                              
  robloxUsername String?                                                                 
  credencialVersion Int @default(1)
  credencialRevocadaEn DateTime?
  credencialRevocacionMotivo String?

  accounts Account[]
  sessions Session[]

  certificacion      CertificacionAbogado?
  causasComoFiscal   Causa[]                @relation("FiscalACargo")
  causasComoFiscalAuxiliar Causa[]          @relation("FiscalAuxiliar")
  causasComoJuez     Causa[]                @relation("JuezACargo")
  defensas           Defensa[]
  escritosPresentados Escrito[]
  audienciasCreadas  Audiencia[]            @relation("AudienciaCreador")
  sentenciasDictadas Sentencia[]            @relation("SentenciaJuez")
  partesEnCausas     ParteCausa[]
  ordenesCapturaSolicitadas OrdenCaptura[]  @relation("OrdenCapturaSolicitante")
  ordenesCapturaRecibidas OrdenCaptura[]    @relation("OrdenCapturaPersona")
  adjuntosFiscales AdjuntoFiscal[]         @relation("AdjuntosFiscalesUsuario")
  testimoniosRegistrados Testimonio[]       @relation("TestimoniosUsuario")
  denunciasPresentadas Denuncia[]
  denunciaAdjuntos DenunciaAdjunto[]
  actasDerechosInformadas ActaDerechosDetenido[] @relation("ActasDerechosFuncionario")
  auditoriasRealizadas Auditoria[] @relation("AuditoriaActor")
  historialFiscales HistorialAsignacionFiscal[] @relation("HistorialFiscalActor")
  partesPolicialesRegistrados PartePolicial[] @relation("PartePolicialRegistrador")
  solicitudesCreadas Solicitud[] @relation("SolicitudCreador")
  solicitudesAsignadas Solicitud[] @relation("SolicitudAsignado")
  demandasPresentadas Demanda[] @relation("DemandaPresentadaPor")
  publicacionesTransparencia PublicacionTransparencia[] @relation("PublicacionesTransparenciaAutor")
  notificaciones        Notificacion[]
}

                                                       
model PublicacionTransparencia {
  id              String   @id @default(cuid())
  titulo          String
  autor           String
  cuerpo          String   @db.Text
  footer          String?  @db.Text
  archivoNombre   String?
  archivoMimeType String?
  archivoTamano   Int?
  archivoDatos    Bytes?
  creadoEn        DateTime @default(now())

  publicadoPorId String
  publicadoPor   User @relation("PublicacionesTransparenciaAutor", fields: [publicadoPorId], references: [id])

  @@index([creadoEn])
}

                                                  
model CertificacionAbogado {
  id             String              @id @default(cuid())
  userId         String              @unique
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  numeroMatricula String             @unique
  estado         EstadoCertificacion @default(PENDIENTE)
  solicitadoEn   DateTime            @default(now())
  revisadoEn     DateTime?
  observaciones  String?             @db.Text
}

                                           
model Causa {
  id            String      @id @default(cuid())
  rit           String      @unique                                          
  ruc           String?                                                       
  caratulado    String                              
  imputado      String?                                                          
  competencia   String?                                                         
  tribunal      String?                                                
  anio          Int      @default(2026)
  descripcion   String      @db.Text
  estado        EstadoCausa @default(EN_INVESTIGACION)
  delito        String
  creadaEn      DateTime    @default(now())
  actualizadaEn DateTime    @updatedAt
  discordForumThreadId String?

  fiscalId String
  fiscal   User   @relation("FiscalACargo", fields: [fiscalId], references: [id])
  fiscalAuxiliarId String?
  fiscalAuxiliar   User?  @relation("FiscalAuxiliar", fields: [fiscalAuxiliarId], references: [id], onDelete: SetNull)

  juezId String?
  juez   User?   @relation("JuezACargo", fields: [juezId], references: [id])

  partes     ParteCausa[]
  defensas   Defensa[]
  escritos   Escrito[]
  audiencias Audiencia[]
  sentencia  Sentencia?
  ordenesCaptura OrdenCaptura[]
  ordenInvestigar OrdenInvestigar?
  adjuntosFiscales AdjuntoFiscal[]
  testimonios Testimonio[]
  actasDerechos ActaDerechosDetenido[]
  historialFiscales HistorialAsignacionFiscal[] @relation("HistorialFiscalCausa")
  notificaciones Notificacion[]
}

model HistorialAsignacionFiscal {
  id String @id @default(cuid())
  causaId String
  causa Causa @relation("HistorialFiscalCausa", fields: [causaId], references: [id], onDelete: Cascade)
  realizadoPorId String
  realizadoPor User @relation("HistorialFiscalActor", fields: [realizadoPorId], references: [id])
  fiscalAnteriorId String?
  fiscalNuevoId String
  fiscalAuxiliarAnteriorId String?
  fiscalAuxiliarNuevoId String?
  motivo String?
  creadoEn DateTime @default(now())
}

model Auditoria {
  id String @id @default(cuid())
  actorId String?
  actor User? @relation("AuditoriaActor", fields: [actorId], references: [id], onDelete: SetNull)
  accion String
  entidad String
  entidadId String?
  detalle String? @db.Text
  creadoEn DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([actorId, creadoEn])
}

                                                                           
                                                                           
                                                                            
                                                                       
model OrdenInvestigar {
  id       String @id @default(cuid())
  causaId  String @unique
  causa    Causa  @relation(fields: [causaId], references: [id], onDelete: Cascade)

  fiscalia          String?
  unidadPolicial    String  @default("AMBAS")                             

                                                                          
  imputadoIndividualizado Boolean @default(true)
  imputadoNombre    String?
  imputadoRut       String?

  victimaNombre     String?                                             

  diligencias       String[] @default([])
  diligenciasOtras  String?

  plazoInforme      String?
  urgencia          String  @default("ORDINARIA")                                            
  formaRemision     String?

  instrucciones             String? @db.Text
  funcionarioPolicialNombre String?

  emitidaEn DateTime @default(now())
}

model OrdenCaptura {
  id          String              @id @default(cuid())
  causaId     String
  causa       Causa               @relation(fields: [causaId], references: [id], onDelete: Cascade)
  solicitadoPorId String
  solicitadoPor User               @relation("OrdenCapturaSolicitante", fields: [solicitadoPorId], references: [id])
  personaId   String?
  persona     User?               @relation("OrdenCapturaPersona", fields: [personaId], references: [id])
  nombrePersona String
  motivo      String              @db.Text
  estado      EstadoOrdenCaptura  @default(VIGENTE)
  emitidaEn   DateTime            @default(now())
  levantadaEn DateTime?

                                                                            
  runOPasaporte     String?                                           
  nacionalidadPersona String?
  fechaNacimiento   String?                                                                       
  domicilioConocido String?
  senasParticulares String?

                                                        
  causalLegal       String  @default("OTRO")                                                          
  causalLegalOtro   String?                                 
  fundamentoCautela String  @db.Text @default("")

                                               
  policiaInstruida  String  @default("AMBAS")                             
  vigenciaOrden     String  @default("Indefinida")

                                                             
  secretarioNombre  String?
}

model AdjuntoFiscal {
  id          String           @id @default(cuid())
  causaId     String
  causa       Causa            @relation(fields: [causaId], references: [id], onDelete: Cascade)
  subidoPorId String
  subidoPor   User             @relation("AdjuntosFiscalesUsuario", fields: [subidoPorId], references: [id])
  tipo        TipoAdjuntoFiscal
  nombre      String
  mimeType    String
  tamano      Int              @default(0)
  datos       Bytes?                                                                          
  url         String?                                                             
  creadoEn    DateTime         @default(now())
}

model Testimonio {
  id          String   @id @default(cuid())
  causaId     String
  causa       Causa   @relation(fields: [causaId], references: [id], onDelete: Cascade)
  registradoPorId String
  registradoPor User  @relation("TestimoniosUsuario", fields: [registradoPorId], references: [id])
  declarante   String
  contenido   String   @db.Text
  creadoEn    DateTime @default(now())
}

                                                                                        
enum RolParte {
  IMPUTADO
  VICTIMA
  QUERELLANTE
  TESTIGO
}

model ParteCausa {
  id       String   @id @default(cuid())
  causaId  String
  causa    Causa    @relation(fields: [causaId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  rol      RolParte
  agregadoEn DateTime @default(now())

  @@unique([causaId, userId, rol])
}

                                        
model Defensa {
  id           String   @id @default(cuid())
  causaId      String
  causa        Causa    @relation(fields: [causaId], references: [id], onDelete: Cascade)
  abogadoId    String
  abogado      User     @relation(fields: [abogadoId], references: [id])
  asumidaEn    DateTime @default(now())
  renunciadaEn DateTime?
  activa       Boolean  @default(true)

  @@unique([causaId, abogadoId, activa])
}

                                                          
enum TipoEscrito {
  QUERELLA
  FORMALIZACION
  ACUSACION
  CONTESTACION
  PRUEBA
  RECURSO
  OTRO
}

model Escrito {
  id            String      @id @default(cuid())
  causaId       String
  causa         Causa       @relation(fields: [causaId], references: [id], onDelete: Cascade)
  autorId       String
  autor         User        @relation(fields: [autorId], references: [id])
  tipo          TipoEscrito
  titulo        String
  contenido     String      @db.Text
  archivoUrl    String?                                     
  presentadoEn  DateTime    @default(now())
}

                                   
model Audiencia {
  id           String          @id @default(cuid())
  causaId      String
  causa        Causa           @relation(fields: [causaId], references: [id], onDelete: Cascade)
  tipo         TipoAudiencia
  estado       EstadoAudiencia @default(PROGRAMADA)
  fechaHora    DateTime
  sala         String?
  notas        String?         @db.Text
  creadorId    String
  creador      User            @relation("AudienciaCreador", fields: [creadorId], references: [id])
  creadaEn     DateTime        @default(now())
  notificaciones Notificacion[]
}

model Notificacion {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  causaId     String
  causa       Causa     @relation(fields: [causaId], references: [id], onDelete: Cascade)
  audienciaId String?
  audiencia   Audiencia? @relation(fields: [audienciaId], references: [id], onDelete: Cascade)
  tipo        String
  titulo      String
  mensaje     String    @db.Text
  leida       Boolean   @default(false)
  creadaEn    DateTime  @default(now())

  @@unique([userId, audienciaId])
  @@index([userId, leida, creadaEn])
}

                                  
enum ResultadoSentencia {
  CONDENATORIA
  ABSOLUTORIA
}

model Sentencia {
  id           String             @id @default(cuid())
  causaId      String             @unique
  causa        Causa              @relation(fields: [causaId], references: [id], onDelete: Cascade)
  juezId       String
  juez         User               @relation("SentenciaJuez", fields: [juezId], references: [id])
  resultado    ResultadoSentencia
  fundamento   String             @db.Text
  pena         String?
  dictadaEn    DateTime           @default(now())
}

                                                            
model Denuncia {
  id             String         @id @default(cuid())
  titulo         String
  delitos        String?        @db.Text
  descripcion    String         @db.Text
  victimaNombre  String?
  victimaRut     String?
  victimarioNombre String?
  victimarioRut  String?
  caracteristicasVictimario String? @db.Text
  lugarHechos    String?
  denuncianteId  String
  denunciante    User           @relation(fields: [denuncianteId], references: [id])
  estado         EstadoDenuncia @default(PENDIENTE)
  creadaEn       DateTime       @default(now())
  adjuntos       DenunciaAdjunto[]
}

                                      
model PartePolicial {
  id                  String   @id @default(cuid())
  tipoProcedimiento   String
  fechaProcedimiento  String
  horaProcedimiento   String?
  lugar               String
  unidadPolicial      String
  funcionarioResponsable String
  involucrados        String?  @db.Text
  relato              String   @db.Text
  observaciones       String?  @db.Text
  creadoEn            DateTime @default(now())
  registradorId       String
  registrador          User @relation("PartePolicialRegistrador", fields: [registradorId], references: [id])

  @@index([fechaProcedimiento])
}

model Solicitud {
  id            String            @id @default(cuid())
  categoria     CategoriaSolicitud
  asunto        String
  descripcion   String            @db.Text
  estado        EstadoSolicitud   @default(ABIERTA)
  respuesta     String?           @db.Text
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt
  creadorId     String
  creador       User              @relation("SolicitudCreador", fields: [creadorId], references: [id])
  asignadoId    String?
  asignado      User?             @relation("SolicitudAsignado", fields: [asignadoId], references: [id])

  @@index([categoria, estado])
  @@index([creadorId])
}

model Demanda {
  id                    String        @id @default(cuid())
  tribunal              String
  materia               String
  demandante            String
  demandanteRut         String?
  demandado             String
  demandadoRut          String?
  hechos                String        @db.Text
  fundamentosDerecho    String        @db.Text
  peticiones            String        @db.Text
  documentosDescripcion String?
  archivoNombre         String?
  archivoMimeType       String?
  archivoTamano         Int?
  archivoDatos          Bytes?
  estado                EstadoDemanda @default(INGRESADA)
  creadoEn              DateTime      @default(now())
  actualizadoEn         DateTime      @updatedAt
  presentadaPorId       String
  presentadaPor         User          @relation("DemandaPresentadaPor", fields: [presentadaPorId], references: [id])

  @@index([estado, creadoEn])
  @@index([presentadaPorId])
}

model DenunciaAdjunto {
  id           String   @id @default(cuid())
  denunciaId   String
  denuncia     Denuncia @relation(fields: [denunciaId], references: [id], onDelete: Cascade)
  subidoPorId  String
  subidoPor    User     @relation(fields: [subidoPorId], references: [id])
  tipo         TipoAdjuntoDenuncia
  nombre       String
  mimeType     String
  tamano       Int
  datos        Bytes?
  url          String?
  creadoEn     DateTime @default(now())
}

                                                                    
model ActaDerechosDetenido {
  id                    String   @id @default(cuid())
  causaId               String?
  causa                 Causa?   @relation(fields: [causaId], references: [id], onDelete: SetNull)
  funcionarioId         String
  funcionario           User     @relation("ActasDerechosFuncionario", fields: [funcionarioId], references: [id])
  unidadPolicial        String
  fechaDiligencia       String
  horaDetencion         String
  horaLectura           String
  lugarDetencion        String
  funcionarioNombre     String
  funcionarioPlaca      String
  ruc                   String?
  detenidoNombre        String
  detenidoRunPasaporte  String
  detenidoNacionalidad  String
  detenidoNacimientoEdad String
  detenidoDomicilio     String
  esMenor               Boolean  @default(false)
  requiereInterprete    Boolean  @default(false)
  interpreteDetalle     String?
  delitosImputados      String   @db.Text
  causalDetencion       String
  ordenNumero           String?
  derechosInformados    String[] @default([])
  silencioEjercido      Boolean  @default(false)
  silencioObservaciones String?
  avisoFamiliar         Boolean  @default(false)
  avisoDetalle          String?
  entrevistaAbogado     Boolean  @default(false)
  abogadoDetalle        String?
  defensorPublico       Boolean  @default(false)
  comunicacionConsular  String   @default("NA")
  lesionesDetalle       String?
  sinLesionesAparentes  Boolean  @default(false)
  observaciones         String?  @db.Text
  detenidoFirma         String?
  testigoFirma          String?
  horaTermino           String
  creadoEn              DateTime @default(now())
}

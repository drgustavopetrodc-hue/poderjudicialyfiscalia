// Esquema de base de datos — Sistema Judicial RP
// Ejecutar: npx prisma db push (tras configurar DATABASE_URL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Roles ----------
enum Rol {
  ADMIN
  JUEZ
  FISCAL
  ABOGADO
  FUNCIONARIO
  CIUDADANO // rol por defecto, puede ser parte/imputado en una causa
}

enum EstadoCertificacion {
  PENDIENTE
  APROBADA
  RECHAZADA
  SUSPENDIDA
}

enum EstadoCausa {
  EN_INVESTIGACION
  FORMALIZADA
  EN_JUICIO
  EN_ESPERA_JUICIO
  EN_APELACION
  SENTENCIADA
  CERRADA
  ARCHIVADA
  SOBRESEIDA
}

enum EstadoOrdenCaptura {
  VIGENTE
  EJECUTADA
  LEVANTADA
}

enum EstadoDenuncia {
  PENDIENTE
  RECIBIDA
  REVISADA
}

enum TipoAdjuntoDenuncia {
  IMAGEN
  VIDEO
}

enum TipoAdjuntoFiscal {
  EVIDENCIA_VISUAL
  OFICIO
  VIDEO
}

enum TipoAudiencia {
  FORMALIZACION
  PREPARACION_JUICIO
  JUICIO_ORAL
  LECTURA_SENTENCIA
  OTRA
}

enum EstadoAudiencia {
  PROGRAMADA
  REALIZADA
  SUSPENDIDA
  CANCELADA
}

// ---------- Auth (NextAuth) ----------
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Usuario ----------
model User {
  id            String    @id @default(cuid())
  name          String?
  discordId     String?   @unique // ID numérico de Discord (snowflake), usado para sincronizar roles
  discordTag    String? // ej: usuario#0000 o nuevo @usuario
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  rol           Rol       @default(CIUDADANO)
  activo        Boolean   @default(true)
  creadoEn      DateTime  @default(now())

  // ---------- Identidad "en personaje" (IC) ----------
  // Datos del personaje de rol, usados en documentos oficiales, certificados
  // e identificaciones — distintos del nombre de la cuenta de Discord.
  nombreIC      String?
  rut           String?   @unique
  nif           String?   @unique // Número de Identificación Fiscal para funcionarios del Ministerio Público
  nacionalidad  String?
  institucion   String? // ej: "Carabineros de Chile", "Policía de Investigaciones", "Poder Judicial"
  robloxUsername String? // usado para obtener la foto de la identificación institucional

  accounts Account[]
  sessions Session[]

  certificacion      CertificacionAbogado?
  causasComoFiscal   Causa[]                @relation("FiscalACargo")
  causasComoJuez     Causa[]                @relation("JuezACargo")
  defensas           Defensa[]
  escritosPresentados Escrito[]
  audienciasCreadas  Audiencia[]            @relation("AudienciaCreador")
  sentenciasDictadas Sentencia[]            @relation("SentenciaJuez")
  partesEnCausas     ParteCausa[]
  ordenesCapturaSolicitadas OrdenCaptura[]  @relation("OrdenCapturaSolicitante")
  ordenesCapturaRecibidas OrdenCaptura[]    @relation("OrdenCapturaPersona")
  adjuntosFiscales AdjuntoFiscal[]         @relation("AdjuntosFiscalesUsuario")
  testimoniosRegistrados Testimonio[]       @relation("TestimoniosUsuario")
  denunciasPresentadas Denuncia[]
  denunciaAdjuntos DenunciaAdjunto[]
  actasDerechosInformadas ActaDerechosDetenido[] @relation("ActasDerechosFuncionario")
}

// ---------- Certificación de abogados ----------
model CertificacionAbogado {
  id             String              @id @default(cuid())
  userId         String              @unique
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  numeroMatricula String             @unique
  estado         EstadoCertificacion @default(PENDIENTE)
  solicitadoEn   DateTime            @default(now())
  revisadoEn     DateTime?
  observaciones  String?             @db.Text
}

// ---------- Causa (expediente) ----------
model Causa {
  id            String      @id @default(cuid())
  rit           String      @unique // Rol Interno del Tribunal, ej: 001-2026
  ruc           String? // Rol Único de Causa (identificador distinto del RIT)
  caratulado    String // ej: "Fisco vs. Juan Pérez"
  tribunal      String? // ej: "Primer Juzgado de Garantía de Santiago"
  descripcion   String      @db.Text
  estado        EstadoCausa @default(EN_INVESTIGACION)
  delito        String
  creadaEn      DateTime    @default(now())
  actualizadaEn DateTime    @updatedAt
  discordForumThreadId String?

  fiscalId String
  fiscal   User   @relation("FiscalACargo", fields: [fiscalId], references: [id])

  juezId String?
  juez   User?   @relation("JuezACargo", fields: [juezId], references: [id])

  partes     ParteCausa[]
  defensas   Defensa[]
  escritos   Escrito[]
  audiencias Audiencia[]
  sentencia  Sentencia?
  ordenesCaptura OrdenCaptura[]
  ordenInvestigar OrdenInvestigar?
  adjuntosFiscales AdjuntoFiscal[]
  testimonios Testimonio[]
  actasDerechos ActaDerechosDetenido[]
}

// ---------- Orden de investigar (Ministerio Público → policía) ----------
// A diferencia de la orden de captura, esta NO requiere firma de un juez —
// es un instrumento administrativo del fiscal dirigido a la PDI/Carabineros
// (art. 79-91 CPP). Se genera automáticamente al registrar cada causa.
model OrdenInvestigar {
  id       String @id @default(cuid())
  causaId  String @unique
  causa    Causa  @relation(fields: [causaId], references: [id], onDelete: Cascade)

  fiscalia          String?
  unidadPolicial    String  @default("AMBAS") // PDI | CARABINEROS | AMBAS

  // El imputado puede no estar identificado al momento de abrir la causa.
  imputadoIndividualizado Boolean @default(true)
  imputadoNombre    String?
  imputadoRut       String?

  victimaNombre     String? // "N/A" si se reserva identidad / no aplica

  diligencias       String[] @default([])
  diligenciasOtras  String?

  plazoInforme      String?
  urgencia          String  @default("ORDINARIA") // ORDINARIA | CON_DETENIDO | SUMA_URGENCIA
  formaRemision     String?

  instrucciones             String? @db.Text
  funcionarioPolicialNombre String?

  emitidaEn DateTime @default(now())
}

model OrdenCaptura {
  id          String              @id @default(cuid())
  causaId     String
  causa       Causa               @relation(fields: [causaId], references: [id], onDelete: Cascade)
  solicitadoPorId String
  solicitadoPor User               @relation("OrdenCapturaSolicitante", fields: [solicitadoPorId], references: [id])
  personaId   String?
  persona     User?               @relation("OrdenCapturaPersona", fields: [personaId], references: [id])
  nombrePersona String
  motivo      String              @db.Text
  estado      EstadoOrdenCaptura  @default(VIGENTE)
  emitidaEn   DateTime            @default(now())
  levantadaEn DateTime?

  // ---------- Datos del imputado/a (sección II de la plantilla) ----------
  runOPasaporte     String? // RUN o pasaporte de la persona requerida
  nacionalidadPersona String?
  fechaNacimiento   String? // texto libre dd/mm/aaaa (dato "en personaje", no siempre disponible)
  domicilioConocido String?
  senasParticulares String?

  // ---------- Fundamento legal (sección IV) ----------
  causalLegal       String  @default("OTRO") // ART_127 | ART_128 | ART_33 | ART_129 | REBELDIA | OTRO
  causalLegalOtro   String? // detalle si causalLegal = OTRO
  fundamentoCautela String  @db.Text @default("")

  // ---------- Resuelvo (sección V) ----------
  policiaInstruida  String  @default("AMBAS") // PDI | CARABINEROS | AMBAS
  vigenciaOrden     String  @default("Indefinida")

  // ---------- Firma y certificación (sección VI) ----------
  secretarioNombre  String?
}

model AdjuntoFiscal {
  id          String           @id @default(cuid())
  causaId     String
  causa       Causa            @relation(fields: [causaId], references: [id], onDelete: Cascade)
  subidoPorId String
  subidoPor   User             @relation("AdjuntosFiscalesUsuario", fields: [subidoPorId], references: [id])
  tipo        TipoAdjuntoFiscal
  nombre      String
  mimeType    String
  tamano      Int              @default(0)
  datos       Bytes? // usado por imágenes/PDF (archivos pequeños, guardados directo en la BD)
  url         String? // usado por videos (alojados en Vercel Blob, por su tamaño)
  creadoEn    DateTime         @default(now())
}

model Testimonio {
  id          String   @id @default(cuid())
  causaId     String
  causa       Causa   @relation(fields: [causaId], references: [id], onDelete: Cascade)
  registradoPorId String
  registradoPor User  @relation("TestimoniosUsuario", fields: [registradoPorId], references: [id])
  declarante   String
  contenido   String   @db.Text
  creadoEn    DateTime @default(now())
}

// Relación entre una causa y las personas involucradas (imputado, víctima, querellante)
enum RolParte {
  IMPUTADO
  VICTIMA
  QUERELLANTE
  TESTIGO
}

model ParteCausa {
  id       String   @id @default(cuid())
  causaId  String
  causa    Causa    @relation(fields: [causaId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  rol      RolParte
  agregadoEn DateTime @default(now())

  @@unique([causaId, userId, rol])
}

// ---------- Defensa técnica ----------
model Defensa {
  id           String   @id @default(cuid())
  causaId      String
  causa        Causa    @relation(fields: [causaId], references: [id], onDelete: Cascade)
  abogadoId    String
  abogado      User     @relation(fields: [abogadoId], references: [id])
  asumidaEn    DateTime @default(now())
  renunciadaEn DateTime?
  activa       Boolean  @default(true)

  @@unique([causaId, abogadoId, activa])
}

// ---------- Escritos (documentos presentados) ----------
enum TipoEscrito {
  QUERELLA
  FORMALIZACION
  ACUSACION
  CONTESTACION
  PRUEBA
  RECURSO
  OTRO
}

model Escrito {
  id            String      @id @default(cuid())
  causaId       String
  causa         Causa       @relation(fields: [causaId], references: [id], onDelete: Cascade)
  autorId       String
  autor         User        @relation(fields: [autorId], references: [id])
  tipo          TipoEscrito
  titulo        String
  contenido     String      @db.Text
  archivoUrl    String? // link a Vercel Blob u otro storage
  presentadoEn  DateTime    @default(now())
}

// ---------- Audiencias ----------
model Audiencia {
  id           String          @id @default(cuid())
  causaId      String
  causa        Causa           @relation(fields: [causaId], references: [id], onDelete: Cascade)
  tipo         TipoAudiencia
  estado       EstadoAudiencia @default(PROGRAMADA)
  fechaHora    DateTime
  sala         String?
  notas        String?         @db.Text
  creadorId    String
  creador      User            @relation("AudienciaCreador", fields: [creadorId], references: [id])
  creadaEn     DateTime        @default(now())
}

// ---------- Sentencia ----------
enum ResultadoSentencia {
  CONDENATORIA
  ABSOLUTORIA
}

model Sentencia {
  id           String             @id @default(cuid())
  causaId      String             @unique
  causa        Causa              @relation(fields: [causaId], references: [id], onDelete: Cascade)
  juezId       String
  juez         User               @relation("SentenciaJuez", fields: [juezId], references: [id])
  resultado    ResultadoSentencia
  fundamento   String             @db.Text
  pena         String?
  dictadaEn    DateTime           @default(now())
}

// ---------- Denuncias (presentadas por civiles) ----------
model Denuncia {
  id             String         @id @default(cuid())
  titulo         String
  descripcion    String         @db.Text
  denuncianteId  String
  denunciante    User           @relation(fields: [denuncianteId], references: [id])
  estado         EstadoDenuncia @default(PENDIENTE)
  creadaEn       DateTime       @default(now())
  adjuntos       DenunciaAdjunto[]
}

model DenunciaAdjunto {
  id           String   @id @default(cuid())
  denunciaId   String
  denuncia     Denuncia @relation(fields: [denunciaId], references: [id], onDelete: Cascade)
  subidoPorId  String
  subidoPor    User     @relation(fields: [subidoPorId], references: [id])
  tipo         TipoAdjuntoDenuncia
  nombre       String
  mimeType     String
  tamano       Int
  datos        Bytes?
  url          String?
  creadoEn     DateTime @default(now())
}

// ---------- Acta de información de derechos al detenido ----------
model ActaDerechosDetenido {
  id                    String   @id @default(cuid())
  causaId               String?
  causa                 Causa?   @relation(fields: [causaId], references: [id], onDelete: SetNull)
  funcionarioId         String
  funcionario           User     @relation("ActasDerechosFuncionario", fields: [funcionarioId], references: [id])
  unidadPolicial        String
  fechaDiligencia       String
  horaDetencion         String
  horaLectura           String
  lugarDetencion        String
  funcionarioNombre     String
  funcionarioPlaca      String
  ruc                   String?
  detenidoNombre        String
  detenidoRunPasaporte  String
  detenidoNacionalidad  String
  detenidoNacimientoEdad String
  detenidoDomicilio     String
  esMenor               Boolean  @default(false)
  requiereInterprete    Boolean  @default(false)
  interpreteDetalle     String?
  delitosImputados      String   @db.Text
  causalDetencion       String
  ordenNumero           String?
  derechosInformados    String[] @default([])
  silencioEjercido      Boolean  @default(false)
  silencioObservaciones String?
  avisoFamiliar         Boolean  @default(false)
  avisoDetalle          String?
  entrevistaAbogado     Boolean  @default(false)
  abogadoDetalle        String?
  defensorPublico       Boolean  @default(false)
  comunicacionConsular  String   @default("NA")
  lesionesDetalle       String?
  sinLesionesAparentes  Boolean  @default(false)
  observaciones         String?  @db.Text
  detenidoFirma         String?
  testigoFirma          String?
  horaTermino           String
  creadoEn              DateTime @default(now())
}
